Задача 8: Форматированный реестр товаров (Вывод на консоль, Срезы, Циклы)
Условие: Создайте срез структур Product (Name, Price, Quantity).

С помощью цикла и fmt.Printf выведите таблицу товаров.

Цена должна быть выведена с 2 знаками после запятой.

Название должно быть выровнено по левому краю с фиксированной шириной (например, 20 символов).

Добавьте итоговую строку с общей стоимостью всех товаров на складе

package main

import "fmt"

type Product struct {
	Name     string
	Price    float64
	Quantity int
}

func main() {
	// 1. Создаем срез товаров
	inventory := []Product{
		{Name: "Клавиатура", Price: 15000.50, Quantity: 10},
		{Name: "Мышь", Price: 8500.00, Quantity: 25},
		{Name: "Монитор 27\"", Price: 125900.99, Quantity: 5},
		{Name: "Коврик", Price: 1200.00, Quantity: 100},
	}

	// Шапка таблицы
	fmt.Printf("%-20s | %-10s | %-10s | %-10s\n", "Название", "Цена", "Кол-во", "Сумма")
	fmt.Println("------------------------------------------------------------------")

	var totalInventoryValue float64

	// 2. Цикл для вывода товаров
	for _, p := range inventory {
		itemTotal := p.Price * float64(p.Quantity)
		totalInventoryValue += itemTotal

		// %-20s  — строка, 20 символов, выравнивание влево
		// %10.2f — число с плавающей точкой, 10 символов всего, 2 после запятой
		// %10d   — целое число, ширина 10 символов
		fmt.Printf("%-20s | %10.2f | %10d | %10.2f\n",
			p.Name, p.Price, p.Quantity, itemTotal)
	}

	// 3. Итоговая строка
	fmt.Println("------------------------------------------------------------------")
	fmt.Printf("%-46s | %10.2f\n", "ИТОГО НА СКЛАДЕ:", totalInventoryValue)
}
