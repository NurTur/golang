Задача 5: Генератор последовательностей (Замыкания)
Условие: Напишите функцию FibonacciGenerator(), которая возвращает функцию (замыкание).

При каждом вызове возвращаемая функция должна выдавать следующее число Фибоначчи.

Продемонстрируйте работу двух независимых генераторов одновременно.
package main

import "fmt"

func FibonacciGenerator() func() int {
	f1, f2 := 0, 1
	return func() int {
		// Запоминаем текущее число для возврата
		current := f1
		// Вычисляем следующую пару: новое f1 становится старым f2,
		// а новое f2 становится суммой f1 + f2
		f1, f2 = f2, f1+f2
		return current
	}
}

func main() {
	// Создаем два независимых генератора
	gen1 := FibonacciGenerator()
	gen2 := FibonacciGenerator()

	fmt.Println("Генератор №1 (первые 5 чисел):")
	for i := 0; i < 5; i++ {
		fmt.Printf("%d ", gen1())
	}

	fmt.Println("\n\nГенератор №2 (делает 3 шага, пока первый 'спит'):")
	fmt.Printf("%d ", gen2())
	fmt.Printf("%d ", gen2())
	fmt.Printf("%d ", gen2())

	fmt.Println("\n\nСнова Генератор №1 (продолжает с того же места):")
	fmt.Printf("%d ", gen1()) // Выведет следующее после пятого
}
